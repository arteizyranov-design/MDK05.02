Задание 5: Массив спорттоваров (Ассоциативный)
<?php
$squares = [];
$currentNumber = 10;

// Заполняем массив 9x10 квадратами чисел от 10 до 99
for ($i = 0; $i < 9; $i++) {
    for ($j = 0; $j < 10; $j++) {
        $squares[$i][$j] = $currentNumber * $currentNumber;
        $currentNumber++;
    }
}

// Выводим в виде таблицы
echo "<table border='1'>";
for ($i = 0; $i < 9; $i++) {
    echo "<tr>";
    for ($j = 0; $j < 10; $j++) {
        echo "<td>" . $squares[$i][$j] . "</td>";
    }
    echo "</tr>";
}
echo "</table>";
?>

Задание 6: Добавление новой категории

Добавляем пустую категорию по строковому ключу.

<?php
$array = [,
 ,
 ,
 ,
    [11, 45, 14, 50]
];

// Предполагаем, что первый элемент является и минимальным, и максимальным
$min = $array[0][0];
$max = $array[0][0];

$minRow = 0; $minCol = 0;
$maxRow = 0; $maxCol = 0;

for ($i = 0; $i < 5; $i++) {
    for ($j = 0; $j < 4; $j++) {
        // Ищем минимум
        if ($array[$i][$j] < $min) {
            $min = $array[$i][$j];
            $minRow = $i;
            $minCol = $j;
        }
        // Ищем максимум
        if ($array[$i][$j] > $max) {
            $max = $array[$i][$j];
            $maxRow = $i;
            $maxCol = $j;
        }
    }
}

echo "Минимум: $min (Индекс по вертикали/строка: $minRow, по горизонтали/столбец: $minCol)<br>";
echo "Максимум: $max (Индекс по вертикали/строка: $maxRow, по горизонтали/столбец: $maxCol)<br>";
?>
