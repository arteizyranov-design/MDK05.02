// Тест 2: Такой категории еще нет
$cat2 = "Водный спорт";
$goods2 = ["Speedo" => "Очки для плавания"];

// Функция для простой вставки
function addCategoryWithGoods(&$array, $category, $goods) {
    if (isset($array[$category])) {
        // Если категория есть, добавляем/объединяем новые товары со старыми
        $array[$category] = $array[$category] + $goods;
    } else {
        // Если категории нет, записываем её целиком
        $array[$category] = $goods;
    }
}

// Применяем функцию для обоих тестов
